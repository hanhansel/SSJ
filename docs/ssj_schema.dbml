// Paste this entire file into https://dbdiagram.io/d
// Source of truth: instance/ssj.db after the normalized document rebuild.

Table users {
  id integer [pk, increment]
  name varchar(100) [not null]
  email varchar(120) [not null, unique]
  password varchar(200) [not null, note: 'Password hash, never plaintext']
  role_id integer [not null]
  is_active boolean
  created_at datetime
}

// Keeps historical attendance independent from a user's current login status.
Table technician_employment_periods {
  id integer [pk, increment]
  user_id integer [not null]
  start_date date [not null]
  end_date date [note: 'Inclusive; null while currently employed']
  created_at datetime
}

// Fixed catalog. Permissions are predetermined in backend policy per role.
Table roles {
  id integer [pk, increment]
  code varchar(50) [not null, unique, note: 'Office | Technician']
  name varchar(100) [not null]
  description varchar(255)
}

Table password_reset_otps {
  id integer [pk, increment]
  user_id integer [not null]
  otp_hash varchar(64) [not null]
  otp_salt varchar(32) [not null]
  expires_at datetime [not null]
  attempts integer [not null]
  created_at datetime
}

// Persistent counter so login/reset rate limits continue across server restarts.
Table auth_rate_limits {
  id integer [pk, increment]
  action varchar(40) [not null, note: 'login | password_reset']
  subject varchar(255) [not null, note: 'Hashed/account request subject plus client address']
  window_started datetime [not null]
  attempts integer [not null]
  last_attempt datetime [not null]

  indexes {
    (action, subject) [unique, name: 'uq_auth_rate_limits_action_subject']
    last_attempt [name: 'ix_auth_rate_limits_last_attempt']
  }
}

Table client_sites {
  id integer [pk, increment]
  company_name varchar(200) [not null]
  address text
  client_type varchar(50)
  latitude float
  longitude float
  pic_name varchar(100)
  pic_phone varchar(50)
  created_at datetime
}

Table master_projects {
  id integer [pk, increment]
  name varchar(200) [not null]
  status varchar(50)
  created_at datetime
}

// Parent table / single global internal document identity.
// document_type determines which one detail table contains the extra fields.
Table documents {
  id integer [pk, increment]
  document_type varchar(20) [not null, note: 'svc | xprj | prj']
  doc_no integer [not null, note: 'Business sequence only; printable code is generated at runtime']
  date date [not null]
  client_id integer [not null]
  status varchar(50) [note: 'Online | Pending Approval | Hold | Completed | Void; Completed and Void are final']
  created_at datetime

  indexes {
    (document_type, doc_no) [unique, name: 'uq_document_type_no']
  }
}

// Joined-inheritance detail: only documents.document_type = 'svc' has this row.
Table doc_svc {
  id integer [pk, note: 'Also FK to documents.id']
  reference varchar(200)
  customer_complaint text
  task_description text
  notes text
  estimated_calendar_days integer
  target_completion date
  actual_completion date
}

// Joined-inheritance detail: only documents.document_type = 'xprj' has this row.
Table doc_xprj {
  id integer [pk, note: 'Also FK to documents.id']
  prj_id integer [note: 'Optional parent PRJ']
  reference varchar(200)
  reference_no varchar(200)
  customer_complaint text
  task_description text
  notes text
  estimated_calendar_days integer
  target_completion date
  actual_completion date
}

// Joined-inheritance detail: only documents.document_type = 'prj' has this row.
Table doc_prj {
  id integer [pk, note: 'Also FK to documents.id']
  title varchar(200) [not null]
  master_project_id integer
  so_number varchar(200) [not null, note: 'Free text; a replacement PRJ may reuse the SO of a voided one']
  site_address text
  admin_notes text
  urgency_level integer [note: '1 = Normal | 2 = Urgent']
  estimated_calendar_days integer
  target_completion date
  actual_completion date
}

Table prj_items {
  id integer [pk, increment]
  prj_id integer [not null]
  description text [not null]
  qty integer
  uom varchar(50)
  display_order integer
}

Table schedule_blocks {
  id integer [pk, increment]
  user_id integer [not null]
  document_id integer [note: 'NULL means technician leave/absence, not a document task']
  start_date date [not null]
  days_duration integer [not null]
  status varchar(50)
  leave_reason varchar(200)
  notes text
}

Table technician_attendances {
  id integer [pk, increment]
  user_id integer [not null]
  date date [not null]
  check_in_time datetime
  check_out_time datetime
  task_id integer [note: 'Legacy reference only; not a database FK']
  task_type varchar(20) [note: 'Legacy type only; not a database FK']
  status varchar(50)
  notes text
  photo_path varchar(255)
  latitude float
  longitude float
  ip_address varchar(50)

  indexes {
    (user_id, date) [unique, name: 'uq_technician_attendance_user_date']
  }
}

Table work_reports {
  id integer [pk, increment]
  document_id integer [not null]
  uploaded_by integer [not null]
  uploaded_at datetime
  report_type varchar(20)
  report_text text
  status varchar(50)
  rejection_note text
}

Table work_report_photos {
  id int [pk, increment]
  report_id int [not null]
  stored_path varchar(500) [not null, unique]
  original_filename varchar(255) [not null]
  file_size int
  uploaded_at datetime [not null]
}

// Exactly one HO per PRJ, created with it. Its printable number uses the PRJ's
// doc_no and date in the ho_format setting; its status mirrors the PRJ.
Table hos {
  id integer [pk, increment]
  prj_id integer [not null, unique]
  ho_number_text varchar(100) [note: 'Frozen printable number, e.g. 040/HO/26']
  date date [not null, note: 'Same as the PRJ date']
  status varchar(50) [not null, note: 'Online | Pending Approval | Hold | Approved | Void']
  notes text
  created_at datetime
  uploaded_at datetime
  uploaded_by integer
  approved_at datetime
  approved_by integer
  completion_date date
}

Table ho_photos {
  id integer [pk, increment]
  ho_id integer [not null]
  stored_path varchar(500) [not null, unique]
  original_filename varchar(255) [not null]
  file_size integer
  uploaded_at datetime [not null]
  uploaded_by integer
}

Table system_settings {
  id integer [pk, increment]
  key varchar(100) [not null, unique]
  value text [not null]
  category varchar(50)
  description varchar(200)
}

Table system_holidays {
  id integer [pk, increment]
  date date [not null, unique]
  description varchar(100) [not null]
}

// Actual foreign-key relationships
Ref: users.role_id > roles.id
Ref: password_reset_otps.user_id > users.id
Ref: technician_employment_periods.user_id > users.id

Ref: documents.client_id > client_sites.id

// Joined inheritance: a subtype row cannot exist without its common document row.
Ref: doc_svc.id - documents.id
Ref: doc_xprj.id - documents.id
Ref: doc_prj.id - documents.id
Ref: doc_prj.master_project_id > master_projects.id
Ref: doc_xprj.prj_id > doc_prj.id

Ref: prj_items.prj_id > doc_prj.id
Ref: schedule_blocks.user_id > users.id
Ref: schedule_blocks.document_id > documents.id
Ref: technician_attendances.user_id > users.id
Ref: work_reports.document_id > documents.id
Ref: work_report_photos.report_id > work_reports.id
Ref: work_reports.uploaded_by > users.id
Ref: hos.prj_id - doc_prj.id
Ref: hos.uploaded_by > users.id
Ref: hos.approved_by > users.id
Ref: ho_photos.ho_id > hos.id
Ref: ho_photos.uploaded_by > users.id
