# Development example. Never commit a real .env or production credentials.
# Production values are written to C:\SSJData\config\ssj.env by the Controller.

# Application runtime
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
TRUST_REVERSE_PROXY=false
SSJ_INTERNAL_HOST=127.0.0.1
SSJ_INTERNAL_PORT=32425

# Leave empty only for local SQLite development.
# Production requires PostgreSQL; the Controller builds this URL from separate fields.
DATABASE_URL=
# Example: postgresql+psycopg2://ssj_app:password@127.0.0.1:5432/ssj_db

# SMTP is required for production password-reset OTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-an-app-password-or-smtp-password
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=SSJ
SMTP_USE_TLS=true
# Set true only for implicit TLS, normally port 465; when true, SMTP_USE_TLS must be false.
SMTP_USE_SSL=false

# Password reset and login protection. Defaults are normally sufficient.
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_SECONDS=3600

# Rotating application log defaults: 10 MiB per file, 10 retained files.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# The production Controller derives these values from SSJ_DATA_ROOT.
# SSJ_DATA_ROOT=C:\SSJData
# UPLOAD_FOLDER=C:\SSJData\uploads
# PRINT_TEMPLATE_FOLDER=C:\SSJData\uploads\print-templates
# LOG_ROOT=C:\SSJData\logs
# LOG_DIR=C:\SSJData\logs\app
# BACKUP_FOLDER=C:\SSJData\backups
# APP_HOSTNAME=ssj.internal
# CADDY_CONFIG_FILE=C:\SSJData\config\Caddyfile
# CADDY_DATA_ROOT=C:\SSJData\caddy\data
# TLS_MODE=internal   (or duckdns: Let's Encrypt via DNS challenge, needs DUCKDNS_API_TOKEN)
# ACME_EMAIL=
# CONTROLLER_STATUS_URL=http://127.0.0.1:32425/cstatus
# CONTROLLER_SERVICE_NAME=SSJApp
# CADDY_SERVICE_NAME=SSJCaddy

# SSJ_ENV_FILE is set on the Windows service process to point at the managed
# production file; it should not be placed inside ssj.env itself.
